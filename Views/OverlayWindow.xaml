<Window x:Class="MouseAccelerator.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True">
    <Grid Background="#18000000" IsHitTestVisible="False">
        <Canvas x:Name="OverlayCanvas"
                ClipToBounds="True"
                SizeChanged="OverlayCanvas_SizeChanged">
            <Canvas x:Name="FloatingGridCanvas"
                    IsHitTestVisible="False"/>

            <Border x:Name="ScreenBorder"
                    Background="#2817B6A4"
                    BorderBrush="White"
                    BorderThickness="4"
                    CornerRadius="12">
                <TextBlock x:Name="ScreenLabel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="18"/>
            </Border>

            <Ellipse x:Name="CursorMarker"
                     Width="11"
                     Height="11"
                     Fill="#F017B6A4"
                     Stroke="White"
                     StrokeThickness="2"/>

            <Border x:Name="LevelLabelBorder"
                    Background="#D9162422"
                    BorderBrush="#9017B6A4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="7,3">
                <TextBlock x:Name="LevelLabel"
                           Foreground="White"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="11"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
