<Window x:Class="MouseAccelerator.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True">
    <Grid Background="#26000000" IsHitTestVisible="False">
        <Canvas x:Name="OverlayCanvas"
                ClipToBounds="True"
                SizeChanged="OverlayCanvas_SizeChanged">
            <Canvas x:Name="ParentGridCanvas"
                    Opacity="0.24"
                    IsHitTestVisible="False"/>

            <Border x:Name="CurrentRegionBorder"
                    Background="#1017B6A4"
                    BorderBrush="#D018C3AF"
                    BorderThickness="3"
                    CornerRadius="12"/>

            <Border x:Name="SelectionBorder"
                    Background="#5217B6A4"
                    BorderBrush="#FFFFFFFF"
                    BorderThickness="4"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="0"
                                      Color="#9017B6A4"/>
                </Border.Effect>
                <TextBlock x:Name="TargetLabel"
                           Text="LEVEL 0 · CELL 2,2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="15"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="10"/>
            </Border>

            <Line x:Name="VerticalLine1"
                  Stroke="#D8FFFFFF"
                  StrokeThickness="2"/>
            <Line x:Name="VerticalLine2"
                  Stroke="#D8FFFFFF"
                  StrokeThickness="2"/>
            <Line x:Name="HorizontalLine1"
                  Stroke="#D8FFFFFF"
                  StrokeThickness="2"/>
            <Line x:Name="HorizontalLine2"
                  Stroke="#D8FFFFFF"
                  StrokeThickness="2"/>
        </Canvas>
    </Grid>
</Window>
