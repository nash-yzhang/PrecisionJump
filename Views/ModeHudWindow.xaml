<Window x:Class="PrecisionJump.Views.ModeHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="224"
        Height="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True">
    <Border x:Name="HudBorder"
            Background="#E6172024"
            BorderBrush="#703FD2C3"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,9">
        <TextBlock x:Name="StatusLabel"
                   Text="SPEED  ·  1–10"
                   Foreground="White"
                   FontFamily="Consolas"
                   FontSize="12"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</Window>
