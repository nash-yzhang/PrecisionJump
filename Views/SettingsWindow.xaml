<Window x:Class="PrecisionJump.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Precision Jump"
        Width="460"
        Height="690"
        MinWidth="420"
        MinHeight="520"
        Background="White"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="SectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="ShortcutStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="TextButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,22">
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderIcon"
                       Width="34"
                       Height="34"
                       Stretch="Uniform"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Precision Jump"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="2"
                          Content="Enabled"
                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FontWeight="SemiBold"/>
            </Grid>

            <TextBlock Text="ACTIVATION" Style="{StaticResource SectionStyle}"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcut" VerticalAlignment="Center"/>
                <TextBlock x:Name="ScreenJumpDisplay"
                           Grid.Column="1"
                           Text="{Binding ScreenJumpDisplay}"
                           Style="{StaticResource ShortcutStyle}"
                           Margin="12,0"/>
                <Button x:Name="RecordScreenJumpButton"
                        Grid.Column="2"
                        Content="Change"
                        Style="{StaticResource TextButtonStyle}"
                        Click="RecordScreenJump_Click"/>
            </Grid>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sequence timeout" FontSize="12"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SequenceTimeoutSeconds, StringFormat={}{0:F2} s}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"/>
            </Grid>
            <Slider Minimum="0.18"
                    Maximum="1"
                    TickFrequency="0.01"
                    IsSnapToTickEnabled="True"
                    Value="{Binding SequenceTimeoutSeconds, Mode=TwoWay}"/>

            <Separator Margin="0,24" Background="{StaticResource LineBrush}"/>

            <Grid>
                <TextBlock Text="POSITION MARKS" Style="{StaticResource SectionStyle}"/>
                <CheckBox Content="Enabled"
                          HorizontalAlignment="Right"
                          IsChecked="{Binding PositionMarksEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,14,0,0" IsEnabled="{Binding PositionMarksEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Save to A–Z / 0–9" VerticalAlignment="Center"/>
                <TextBlock x:Name="SavePositionDisplay"
                           Grid.Column="1"
                           Text="{Binding SavePositionDisplay}"
                           Style="{StaticResource ShortcutStyle}"
                           Margin="12,0"/>
                <Button x:Name="RecordSavePositionButton"
                        Grid.Column="2"
                        Content="Change"
                        Style="{StaticResource TextButtonStyle}"
                        Click="RecordSavePosition_Click"/>
            </Grid>
            <Grid Margin="0,8,0,0" IsEnabled="{Binding PositionMarksEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Jump to A–Z / 0–9" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecallPositionDisplay"
                           Grid.Column="1"
                           Text="{Binding RecallPositionDisplay}"
                           Style="{StaticResource ShortcutStyle}"
                           Margin="12,0"/>
                <Button x:Name="RecordRecallPositionButton"
                        Grid.Column="2"
                        Content="Change"
                        Style="{StaticResource TextButtonStyle}"
                        Click="RecordRecallPosition_Click"/>
            </Grid>
            <Grid Margin="0,10,0,0">
                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                    <Run Text="{Binding SavedPositionCount, Mode=OneWay}"/>
                    <Run Text=" saved"/>
                </TextBlock>
                <Button Content="Clear"
                        HorizontalAlignment="Right"
                        Style="{StaticResource TextButtonStyle}"
                        IsEnabled="{Binding PositionMarksEnabled}"
                        Click="ClearSavedPositions_Click"/>
            </Grid>

            <Separator Margin="0,24" Background="{StaticResource LineBrush}"/>

            <TextBlock Text="MOVEMENT" Style="{StaticResource SectionStyle}"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Travel per map unit"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectionDistance, StringFormat={}{0:F0} px}"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
            <Slider Minimum="8"
                    Maximum="120"
                    TickFrequency="2"
                    IsSnapToTickEnabled="True"
                    Value="{Binding SelectionDistance, Mode=TwoWay}"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Maximum zoom depth"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding MaximumZoomLevel}"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
            <Slider Minimum="1"
                    Maximum="10"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding MaximumZoomLevel, Mode=TwoWay}"/>

            <Separator Margin="0,24" Background="{StaticResource LineBrush}"/>

            <TextBlock Text="OPTIONS" Style="{StaticResource SectionStyle}"/>
            <CheckBox Content="Show status HUD"
                      IsChecked="{Binding ShowStatusHud, Mode=TwoWay}"
                      Margin="0,14,0,0"/>
            <CheckBox Content="Record mouse events to CSV"
                      IsChecked="{Binding RecordMouseEvents, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,10,0,0"/>

            <Button Content="Restore defaults"
                    HorizontalAlignment="Left"
                    Style="{StaticResource TextButtonStyle}"
                    Foreground="{StaticResource MutedBrush}"
                    Margin="-8,22,0,0"
                    Click="RestoreDefaults_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
